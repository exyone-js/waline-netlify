      .then(async (resp) => {
        const data = await resp.json().catch(() => ({}));

        // 数据文件不存在时 GitHub 返回 404 且响应体无 content 字段，
        // 必须在此抛出带状态码的错误，否则 Buffer.from(undefined) 会崩溃
        if (resp.status === 404) {
          const error = new Error(data.message || 'NOT FOUND');

          error.statusCode = 404;
          throw error;
        }
        if (!resp.ok || data.content === undefined) {
          const error = new Error(data.message || `GitHub API error: ${resp.status}`);

          error.statusCode = resp.status;
          throw error;
        }

        return data;
      })
